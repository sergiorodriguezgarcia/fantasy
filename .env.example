# ── Base de datos ─────────────────────────────────────────────
# Local:
DATABASE_URL=postgresql://fantasy_user:fantasy_pass@localhost:5432/fantasy_asturfutbol
# Producción (Neon) — copiar desde neon.tech > tu proyecto > Connection string
# DATABASE_URL=postgresql://user:pass@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=cambia_esto_por_algo_secreto_largo_y_aleatorio_minimo_32_chars

# ── Servidor ──────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── CORS ──────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
# Producción: FRONTEND_URL=https://tu-app.vercel.app

# ── Cron secret ───────────────────────────────────────────────
# Genera un string aleatorio y ponlo en Railway > Variables
# Railway Cron llamará a POST /api/cron/importar-jornada con header X-Cron-Secret: <valor>
CRON_SECRET=string_aleatorio_secreto
